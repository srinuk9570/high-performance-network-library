# Clang-Tidy configuration for High-Performance Network Library
#
# Static analysis configuration for the C++ networking library.
# The project uses C++17 and focuses on Linux/POSIX networking,
# concurrency, performance, and maintainable systems code.

---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-signed-char-misuse,
  -bugprone-suspicious-include,
  -bugprone-unhandled-self-assignment,
  -clang-analyzer-cplusplus.NewDelete,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-security.insecureAPI.rand,
  -clang-diagnostic-implicit-int-float-conversion,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -readability-convert-member-functions-to-static,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,
  -readability-make-member-function-const,
  -readability-qualified-auto,
  -readability-redundant-access-specifiers,
  -bugprone-exception-escape

CheckOptions:
  - { key: readability-identifier-naming.ClassCase,          value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,           value: CamelCase }
  - { key: readability-identifier-naming.FunctionCase,       value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantCase, value: UPPER_CASE }
  - { key: readability-identifier-naming.MemberCase,         value: lower_case }
  - { key: readability-identifier-naming.MemberSuffix,       value: _ }
  - { key: readability-identifier-naming.NamespaceCase,      value: lower_case }
  - { key: readability-identifier-naming.StructCase,         value: CamelCase }
  - { key: readability-identifier-naming.UnionCase,          value: CamelCase }
  - { key: readability-identifier-naming.VariableCase,       value: lower_case }

WarningsAsErrors: '*'

# Analyze project source and test headers.
HeaderFilterRegex: '(/|\\)(src|test)(/|\\)'

# Enable temporary destructor analysis.
AnalyzeTemporaryDtors: true

# Disabled checks:
#
# bugprone-easily-swappable-parameters
#   Disabled because networking APIs may legitimately use multiple
#   parameters with the same type.
#
# bugprone-implicit-widening-of-multiplication-result
#   Disabled to avoid noisy diagnostics in low-level systems code.
#
# bugprone-narrowing-conversions
#   Disabled because explicit low-level conversions may be intentional
#   in networking and systems programming.
#
# bugprone-reserved-identifier
#   Disabled for compatibility with platform/system identifiers.
#
# bugprone-signed-char-misuse
#   Disabled where byte-oriented networking code intentionally uses
#   char-based buffers.
#
# bugprone-suspicious-include
#   Disabled because some third-party/test headers may trigger false
#   positives.
#
# bugprone-unhandled-self-assignment
#   Disabled until project-specific cases are reviewed.
#
# clang-analyzer-cplusplus.NewDelete
# clang-analyzer-cplusplus.NewDeleteLeaks
#   Disabled because memory correctness is additionally checked using
#   sanitizers and runtime testing.
#
# clang-analyzer-security.insecureAPI.rand
#   Disabled because random-number usage may be intentional in tests
#   or benchmarks.
#
# modernize-use-nodiscard
#   Disabled to avoid forcing annotations throughout the existing API.
#
# modernize-avoid-c-arrays
#   Disabled because low-level networking code may use C-style buffers.
#
# readability-magic-numbers
#   Disabled because protocol constants and low-level configuration
#   values may be intentionally numeric.
#
# readability-identifier-length
#   Disabled because short variable names are sometimes appropriate
#   in low-level networking code.
#
# readability-function-cognitive-complexity
#   Disabled to avoid excessive warnings in event-driven networking
#   code.
#
# readability-convert-member-functions-to-static
#   Disabled where member functions intentionally belong to the class
#   interface.
#
# readability-make-member-function-const
#   Disabled where mutability is part of the networking/event-loop design.
#
# readability-qualified-auto
#   Disabled to keep existing C++ code concise.
#
# readability-redundant-access-specifiers
#   Disabled to avoid unnecessary style-only diagnostics.
#
# bugprone-exception-escape
#   Disabled because exception behavior in callback/event-loop code
#   requires project-specific handling.